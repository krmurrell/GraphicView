<?xml version="1.0" encoding="utf-8"?>
<!--
  GraphicView – web.config
  ─────────────────────────────────────────────────────────────
  Before running the application update the connection string
  below to point at your SQL Server instance.  Two formats are
  shown; uncomment the one that fits your environment.
-->
<configuration>

  <!-- ═══════════════════════════════════════════════════════
       Connection string
       ─────────────────────────────────────────────────────
       Option A – Windows Authentication (Integrated Security)
       Option B – SQL Server Authentication
       ═══════════════════════════════════════════════════════ -->
  <connectionStrings>

    <!-- Option A: Windows / Integrated Security (most common for dev) -->
    <add name="GraphicViewDB"
         connectionString="Data Source=.\SQLEXPRESS;Initial Catalog=GraphicViewDB;Integrated Security=True"
         providerName="System.Data.SqlClient" />

    <!-- Option B: SQL Server login – replace placeholders and uncomment
    <add name="GraphicViewDB"
         connectionString="Data Source=YOUR_SERVER;Initial Catalog=GraphicViewDB;User Id=YOUR_USER;Password=YOUR_PASSWORD"
         providerName="System.Data.SqlClient" />
    -->

  </connectionStrings>

  <appSettings>
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
  </appSettings>

  <system.web>
    <!-- For local development, change debug="false" to debug="true" to get
         full compiler error messages and skip output caching.
         Always keep debug="false" in production. -->
    <compilation debug="false" targetFramework="4.7.2" />
    <httpRuntime targetFramework="4.7.2" maxRequestLength="4096" />
    <customErrors mode="RemoteOnly" defaultRedirect="~/Error.aspx" />
    <pages>
      <namespaces>
        <add namespace="System.Web.Optimization" />
      </namespaces>
    </pages>
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForRequest="true" />
    <directoryBrowse enabled="false" />
    <staticContent>
      <mimeMap fileExtension=".woff"  mimeType="application/font-woff" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
    </staticContent>
  </system.webServer>

</configuration>
